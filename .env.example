# ============================================================
# zen-claw 环境变量配置模板
# 用法：cp .env.example .env，然后填写真实值
# 注意：.env 文件绝对不要提交到 git！
# ============================================================

# ──────────────────────────────────────────────────────────
# 服务端口（可选，默认值如下）
# ──────────────────────────────────────────────────────────

# Dashboard UI 端口（浏览器访问）
DASHBOARD_PORT=18791

# Agent Gateway 端口（API 接口）
GATEWAY_PORT=18790

# ChromaDB 端口（仅在 --profile rag 时有效）
CHROMA_PORT=8000

# ──────────────────────────────────────────────────────────
# LLM 提供商 API 密钥（至少配置一个）
# ──────────────────────────────────────────────────────────

# Anthropic Claude（推荐）
# 申请地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI（GPT-4o / o3 等）
# 申请地址：https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# OpenRouter（聚合多家模型，支持免费额度）
# 申请地址：https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-...

# DeepSeek（国内访问推荐）
# 申请地址：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...

# 阿里云通义千问（DashScope）
# DASHSCOPE_API_KEY=sk-...

# Groq（超快推理，免费额度慷慨）
# GROQ_API_KEY=gsk_...

# Moonshot（月之暗面）
# MOONSHOT_API_KEY=sk-...

# AiHubMix（聚合中转，支持 Claude + GPT + Gemini）
# AIHUBMIX_API_KEY=...

# Gemini
# GEMINI_API_KEY=...

# ──────────────────────────────────────────────────────────
# 消息渠道（按需启用，至少启用一个渠道或使用 WebChat）
# ──────────────────────────────────────────────────────────

# Telegram Bot
# 申请方式：在 Telegram 找 @BotFather，发送 /newbot
# TELEGRAM_BOT_TOKEN=123456789:AAF...
# TELEGRAM_ENABLED=true

# Discord Bot
# 申请地址：https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=MTI...
# DISCORD_ENABLED=true

# Feishu / Lark（飞书）
# FEISHU_APP_ID=cli_...
# FEISHU_APP_SECRET=...
# FEISHU_ENCRYPT_KEY=...
# FEISHU_ENABLED=true

# WeChat Official Account（微信公众号）
# WECHAT_APP_ID=wx...
# WECHAT_APP_SECRET=...
# WECHAT_TOKEN=...
# WECHAT_ENABLED=true

# ──────────────────────────────────────────────────────────
# 工具配置
# ──────────────────────────────────────────────────────────

# Brave Search API（网页搜索工具）
# 申请地址：https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=BSA...

# ──────────────────────────────────────────────────────────
# 安全与多租户（进阶配置）
# ──────────────────────────────────────────────────────────

# Dashboard API 密钥（留空则关闭鉴权，生产环境务必设置）
# ZEN_CLAW_API_KEYS=your-secret-key-1,your-secret-key-2

# 多租户模式 JWT 密钥（开启多租户时必填，建议 32 位以上随机字符串）
# ZEN_CLAW_JWT_SECRET=your-very-long-random-secret

# ──────────────────────────────────────────────────────────
# 数据目录（容器内固定为 /data，宿主机通过 volume 挂载）
# ──────────────────────────────────────────────────────────
ZEN_CLAW_DATA_DIR=/data
